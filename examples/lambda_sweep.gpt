reset
set terminal qt size 800,600 title "Coulomb Coupling Sweep" font "Helvetica,12"

set title "Wigner Crossover: Energy vs Coulomb Coupling (λ)" font "Helvetica,14"
set xlabel "Coulomb Coupling λ"
set ylabel "Energy (ħω)"

# Clean up the borders
set border 3
set tics nomirror
set grid ytics lc rgb "#e0e0e0"

set logscale x
set xrange [10.0:0.005] reverse # Reverse so it goes from localized (high λ) to free (low λ)
set yrange [0:80]

set key top left

set arrow from 10.0,14 to 0.005,14 nohead dt 2 lc "black" lw 2

plot \
    'lambda_sweep.dat' using 1:3:4 with yerrorbars pt 7 ps 1.5 lc "black" title "Bosonic Bound (Sign-Free)", \
    '' using 1:6 with linespoints pt 6 ps 1.5 lw 2 lc rgb "#0072bd" title "Raw MC Estimator", \
    '' using 1:7 with linespoints pt 4 ps 1.5 lw 2 lc rgb "#d95319" title "Linear Model", \
    '' using 1:8 with linespoints pt 8 ps 1.5 lw 2 lc rgb "#edb120" title "Deep LSTM Model"

# set terminal pngcairo size 800,600 font "Helvetica,12"
# set output "lambda_sweep.png"
