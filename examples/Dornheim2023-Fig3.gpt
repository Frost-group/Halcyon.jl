# Dornheim2023-Fig3.gpt
# Figure 3: Average Sign vs ξ
# Ref: Dornheim et al. (2023), Figure 3

set terminal pdfcairo enhanced font "Helvetica,10" size 5in,4in
set output "Dornheim2023-Fig3.pdf"

set title "Average Sign S(ξ) (N=6, β=1)" font ",12"
set xlabel "ξ"
set ylabel "S(ξ)"
set xrange [-1.1:1.1] # full range: I think Dornheim plots just negatives? (Fermionic)
set yrange [1e-3:1.1]
set logscale y
set grid
set key top left

plot \
    "Dornheim2023_lambda0.0.tsv" using 1:6:7 with yerrorbars pt 7 ps 0.6 lw 2 lc rgb "#e41a1c" title "λ=0.0", \
    "Dornheim2023_lambda0.2.tsv" using 1:6:7 with yerrorbars pt 5 ps 0.6 lw 2 lc rgb "#377eb8" title "λ=0.2", \
    "Dornheim2023_lambda0.5.tsv" using 1:6:7 with yerrorbars pt 9 ps 0.6 lw 2 lc rgb "#4daf4a" title "λ=0.5", \
    "Dornheim2023_lambda1.0.tsv" using 1:6:7 with yerrorbars pt 11 ps 0.6 lw 2 lc rgb "#c2c500" title "λ=1.0"

unset logscale y
set output

set terminal pngcairo size 800,600 enhanced font 'Helvetica,14'
set output "Dornheim2023-Fig3.png"
replot

