reset
set terminal qt size 1000,600 title "Convergence with Budget" font "Helvetica,12"

set title "Convergence of Energy Estimators vs Monte Carlo Budget" font "Helvetica,14"
set xlabel "Monte Carlo Steps (Millions)"
set ylabel "Energy (ħω)"

# Clean up the borders
set border 3
set tics nomirror
set grid ytics lc rgb "#e0e0e0"

set logscale x
set xrange [0.8:400]
set yrange [0:100]

set key top right

set arrow from 0.8,14 to 400,14 nohead dt 2 lc "black" lw 2 title "E_0^{NI}"

plot \
    'budget_convergence_unb.dat' using 1:4 with linespoints pt 6 ps 1.5 dt 2 lw 2 lc rgb "#0072bd" title "Raw MC (Unbiased)", \
    'budget_convergence_unb.dat' using 1:5 with linespoints pt 4 ps 1.5 dt 2 lw 2 lc rgb "#d95319" title "Linear Model (Unbiased)", \
    'budget_convergence_unb.dat' using 1:6 with linespoints pt 8 ps 1.5 dt 2 lw 2 lc rgb "#edb120" title "Deep LSTM (Unbiased)", \
    'budget_convergence_is.dat'  using 1:2 with linespoints pt 7 ps 1.5 lw 3 lc rgb "#0072bd" title "Raw MC (IS)", \
    'budget_convergence_is.dat'  using 1:3 with linespoints pt 5 ps 1.5 lw 3 lc rgb "#d95319" title "Linear Model (IS)", \
    'budget_convergence_is.dat'  using 1:4 with linespoints pt 9 ps 1.5 lw 3 lc rgb "#edb120" title "Deep LSTM (IS)"

# set terminal pngcairo size 1000,600 font "Helvetica,12"
# set output "convergence.png"
