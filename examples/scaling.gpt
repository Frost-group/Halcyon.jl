reset
set terminal qt size 1200,500 title "Scaling Limitations" font "Helvetica,12"

set multiplot layout 1,2 title "Scaling the Exponential Wall: Temperature and Density Limitations" font "Helvetica,14"

# ==========================================
# Panel 1: Beta Scaling
# ==========================================
set title "Temperature Scaling (N=6, IS, λ=1)"
set xlabel "Inverse Temperature β"
set ylabel "Energy (ħω)"

set border 3
set tics nomirror
set grid ytics lc rgb "#e0e0e0"

set logscale x
set xrange [0.2:15]
set yrange [0:60]

set key top right

set arrow 1 from 0.2,14 to 15,14 nohead dt 2 lc "black" lw 2

plot \
    'scaling_beta.dat' using 1:2 with linespoints pt 7 ps 1.5 lw 2 lc rgb "#0072bd" title "Raw MC", \
    '' using 1:3 with linespoints pt 5 ps 1.5 lw 2 lc rgb "#d95319" title "Linear Model", \
    '' using 1:4 with linespoints pt 9 ps 1.5 lw 2 lc rgb "#edb120" title "Deep LSTM Model"

# ==========================================
# Panel 2: N Scaling
# ==========================================
set title "Density Scaling (β=1.0, IS, λ=1)"
set xlabel "Number of Particles N"
set ylabel "Energy (ħω)"

set nologscale x
set xrange [2:13]
set yrange [0:50]
set xtics 2

unset arrow 1

plot \
    'scaling_n.dat' using 1:2 with linespoints pt 7 ps 1.5 lw 2 lc rgb "#0072bd" title "Raw MC", \
    '' using 1:3 with linespoints pt 5 ps 1.5 lw 2 lc rgb "#d95319" title "Linear Model", \
    '' using 1:4 with linespoints pt 9 ps 1.5 lw 2 lc rgb "#edb120" title "Deep LSTM Model", \
    '' using 1:5 with lines dt 2 lw 2 lc "black" title "Non-interacting Bound (E_0^{NI})"

unset multiplot

# set terminal pngcairo size 1200,500 font "Helvetica,12"
# set output "scaling.png"
