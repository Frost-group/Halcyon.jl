# cycle-length p-mult(infinite t) DuBois-p2 MAP MaxEnt(unconstrained)

set xlabel "Cycle length, l"
set ylabel "Cycle penalty theta_l (nats)"

p "PermutationFamily_theta_models.dat" u 1:2 w lp title "Combinatorial limit (Inf T)",\
   '' u 1:3 w lp title "DuBois 1-parameter",\
   '' u 1:4 w lp title "MAP (regularised with DuBois prior)",\
   '' u 1:5 w lp title "MaxEnt (unconstrained)"

pause -1 "Rescale / relocate with mouse. Enter to dump PNG; Cmd-c to escape."

set terminal pngcairo size 800,600 enhanced font 'Helvetica,14'
set output "PermutationFamily_theta_models.png"
replot
