# count  family_index  P_hat  P_mult  P_p2  P_map  P_full  λ (nonzero parts, descending)

set xlabel "Permutation family index"
set ylabel "Probability"

set logscale y
#set yrange [1e-10:1e-1] # same as DeBois S2 axis
set yrange [1e-14:1e-1] # Dubois-p2 fit on the 33 Fermi gas goes down to 1e-14

set xrange [0:10143]

# cat *_fit.dat | sort -rgk3 > t.dat # sort by MC
# -rgk5 to sort by DuBois p2
p "PermutationFamily_histogram_fit.dat" u 0:3 title "MC" lc black, \
  '' u 0:5 title "Fit:DuBois-p2/Kappa" w d lc rgb "blue", \
  '' u 0:6 title "Fit:MAP-on-p2" w d lc rgb "orange" #,\
#    '' u 2:7 title "Fit:FullMaxEnt" w d 

pause -1 "Rescale / relocate with mouse. Enter to dump PNG; Cmd-c to escape."

set terminal pngcairo size 800,600 enhanced font 'Helvetica,14'
set output "PermutationFamily_histogram_fit.png"
replot


